PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your actual MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/studiosync?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Email SMTP Settings (For Support Emails & Booking Confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
